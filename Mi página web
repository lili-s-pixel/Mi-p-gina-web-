<h1>creado por lucero</h1>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi página web</title>

    <!-- CSS -->
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #ff9a9e, #fad0c4);
            text-align: center;
            color: white;
        }

        header {
            background: #d63384;
            padding: 25px;
        }

        h1 {
            font-size: 35px;
        }

        .contenedor {
            background: white;
            color: #d63384;
            margin: 60px auto;
            padding: 35px;
            width: 70%;
            border-radius: 20px;
            box-shadow: 0 5px 15px #888;
        }

        button {
            background: #d63384;
            color: white;
            padding: 15px 25px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-size: 16px;
            transition: 0.3s;
        }

        button:hover {
            background: #a02060;
            transform: scale(1.1);
        }

        footer {
            padding: 20px;
        }
    </style>
</head>

<body>

    <header>
        <h1>Mi página web</h1>
        <p>Bienvenidos a mi sitio web</p>
    </header>

    <div class="contenedor">
        <h2>¡Hola, mundo! 💗</h2>

        <p>
            Esta página fue creada utilizando
            HTML, CSS y JavaScript.
        </p>

        <button onclick="mostrarMensaje()">
            Haz clic aquí
        </button>

        <p id="mensaje"></p>
    </div>

    <footer>
        <p>Mi primera página web - 2026</p>
    </footer>

    <!-- JavaScript -->
    <script>
        function mostrarMensaje() {
            document.getElementById("mensaje").innerHTML =
                "¡Gracias por visitar mi página web! 💗";
        }
    </script>

</body>
</html>
